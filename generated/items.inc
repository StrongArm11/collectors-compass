    {3, 0, 0, 1, 0, 232, 1, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, -1.90f, 87.50f, -3.80f, "SR-WEL1", "Basement room under the centre (use the Lens of Truth)", "Bottom of the Well", "Child \x84" " Song of Storms", -1, 0, 5, "Go down into the Bottom of the Well as child Link.\nGetting there needs: Song of Storms.\nTake the way into the basement room under the centre of the well.\nUse the Lens of Truth: some rupees sit behind fake walls or over hidden holes.\nCollect all five silver rupees to open the gate."},
    {3, 15, 0, 2, 0, 233, 1, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, -33.90f, 103.50f, -26.40f, "SR-ICE1", "Sliding ice-block room", "Ice Cavern", "Adult \x84" " Zelda's Lullaby", 0, 5, 5, "In the Ice Cavern (adult), go past the spinning-blade room and the Ice Keese.\nGetting there needs: Zelda's Lullaby.\nMelt the red ice with Blue Fire to enter the room with the big ice block.\nPush the block across the floor as a step to reach each rupee; push it off an edge to reset it.\nAll five open the door on the south side."},
    {3, 15, 0, 2, 0, 234, 1, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, 5.70f, 102.30f, -14.10f, "SR-ICE2", "Spinning-blade room", "Ice Cavern", "Adult \x84" " Zelda's Lullaby", 0, 10, 5, "In the Ice Cavern (adult), go past the Freezard room to the room with the spinning ice blade.\nGetting there needs: Zelda's Lullaby.\nRun around the blade: three rupees are in the middle, one behind icicles (break them).\nFor the last one climb the far platforms and jump down toward the middle.\nAll five open the far doorway."},
    {3, 23, 0, 2, 0, 235, 2, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, 82.40f, 88.30f, -33.40f, "SR-SHA1", "Invisible spinning-scythe room", "Shadow Temple", "Adult \x84" " Nocturne of Shadow \x84" " Hover Boots", -2, 15, 5, "In the Shadow Temple, go past the Beamos room and the Compass room.\nGetting there needs: Nocturne of Shadow, Hover Boots.\nUse the Lens of Truth: two invisible scythes spin around the room - roll under them.\nFour rupees are on the floor; Hookshot up to the wooden ledge and jump off for the fifth.\nAll five open the way to a Small Key."},
    {3, 23, 0, 2, 0, 237, 2, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, 56.30f, 59.50f, 78.90f, "SR-SHA2", "Falling-spike room with the Beamos", "Shadow Temple", "Adult \x84" " Nocturne of Shadow \x84" " Hover Boots", -3, 20, 5, "In the Shadow Temple, go to the room with the falling spike blades and a Beamos.\nGetting there needs: Nocturne of Shadow, Hover Boots.\nHover Boots help you cross; ride the rising platform when it comes up.\nCollect the four rupees you can see, then bomb the Beamos to free the fifth.\nAll five open the way on."},
    {3, 23, 0, 2, 0, 239, 2, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, 54.20f, 55.50f, 34.00f, "SR-SHA3", "Spike-trap room with the ReDead", "Shadow Temple", "Adult \x84" " Nocturne of Shadow \x84" " Hover Boots", -3, 25, 5, "In the Shadow Temple, go through the Small Key door to the spike room with ReDeads.\nGetting there needs: Nocturne of Shadow, Hover Boots.\nUse the Lens of Truth to see the hidden ledges and Hookshot targets.\nHookshot between them to reach all five rupees; keep away from the ReDeads.\nAll five open the west doorway."},
    {3, 24, 0, 1, 0, 241, 1, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, -14.20f, 107.10f, -58.90f, "SR-SPI1", "Child side: the room with the net and the chest", "Spirit Temple", "Child \x84" " Requiem of Spirit", 0, 30, 5, "In the Spirit Temple (child side), go to the room with the climbing net and the chest.\nGetting there needs: Requiem of Spirit.\nCollect the rupees on the floor; climb the net for the high ones.\nWatch for the rolling boulder and the enemies while you run.\nAll five open the gate to the next room."},
    {3, 24, 0, 1, 0, 242, 1, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, -46.60f, 132.70f, -26.20f, "SR-SPI2", "Child side: sun-switch block room before the Iron Knuckle", "Spirit Temple", "Child \x84" " Requiem of Spirit", 2, 35, 5, "In the Spirit Temple (child side), go to the room with the sun switch blocks, before the Iron Knuckle.\nGetting there needs: Requiem of Spirit.\nPush the blocks and use the sun switch to reach the rupees on the high spots.\nAll five open the way on."},
    {3, 24, 0, 2, 0, 243, 2, 0x0000000000000000ULL, 3, 0x0000000000000000ULL, 48.90f, 103.40f, -51.30f, "SR-SPI3", "Adult side: rolling-boulder room (Song of Time block)", "Spirit Temple", "Adult \x84" " Requiem of Spirit or Longshot or Hover Boots \x84" " Silver Gauntlets", 0, 40, 5, "In the Spirit Temple (adult side), go to the room with the rolling boulders.\nGetting there needs: Requiem of Spirit or Longshot or Hover Boots, Silver Gauntlets.\nPlay the Song of Time to move the block and time your runs between the boulders.\nCollect all five to open the door."},
